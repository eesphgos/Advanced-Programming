        File.AppendAllText("users.txt",$"phonenumber: {user.num} \n");
        File.AppendAllText("users.txt",$"contacts:\n");
        

        return true;
    }

    public static User RetrieveUserInfo(string phonenumber)
    {
        string[] file = File.ReadAllLines("users.txt");
        User aaa = new User();
        bool ad = true;
        try
        {
           for(int i = 0; i < file.Length; i++)
            {
                if (file[i] == phonenumber)
                {
                    ad = false;
                    aaa.name = file[i - 2];
                    aaa.famil = file[i - 1];
                    aaa.num = file[i];
                    char[] a = file[i].ToCharArray();
                    while (a[0] == ' ')
                    {
                        i++;
                        a = file[i].ToCharArray();
                        if (a[0]==' ')
                        {
                            contact b = new contact();
                            b.name = file[i];
                            b.famil = file[i + 1];
                            b.num = file[i + 2];
                            if (file[i+3] == "Work") { b.a = type.Work; }
                            if (file[i+3] == "School") { b.a = type.School;}
                            if (file[i+3] == "Friend") { b.a = type.Friend; }
                            if (file[i+3] == "Family") { b.a = type.Family; }
                            if (file[i+3] == "Other") { b.a = type.Other; }
                            i += 3;
                            aaa.contacts.Add(b);
                        }
                    }
                }
            }
            if (!ad) { throw new Exception(); }
        }
        catch
        {
            Console.WriteLine("not found");
        }
        return aaa;
    }

