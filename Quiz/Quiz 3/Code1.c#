    public static User GetUserInfo(string nam ,string last,string number)
    {


        char[] namee = nam.ToCharArray();
        char[] laste = last.ToCharArray();
        char[] numb = number.ToCharArray();

        try
        {
            if(namee.Length<2 || namee.Length>30 || laste.Length <2 || laste.Length>50 || numb.Length!=11 || numb[0]!='0' || numb[1]!= '9')
            {
                throw new Exception();
            }
            for(int i = 0; i < namee.Length; i++)
            {
                if (!char.IsLetter(namee[i]))
                {
                    throw new Exception();
                }
            }
            for (int i = 0; i < laste.Length; i++)
            {
                if (!char.IsLetter(laste[i]))
                {
                    throw new Exception();
                }
            }
            string[] totall = File.ReadAllLines("users.txt");
            foreach(string i in totall)
            {
                if (i == number) { throw new Exception(); }
            }
        }
        catch
        {
            Console.WriteLine("wrong entry");
        }
        User a = new User();
        a.name = nam;
        a.famil = last;
        a.num = number;
        return a;
    }

    public static bool SaveUser(User user)
