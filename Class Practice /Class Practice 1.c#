using System;

class person
{
    string phon;
    public string name;
    public int age;

    public person(string name, string phon)
    {
        this.name = name;
        this.phon = phon;
    }
    public person(string name, int age)
    {
        this.name = name;
        this.age = age;
    }
    public void info()
    {
        if (phon != null)
        {
            Console.WriteLine($"name : {name}  >> phone number : {phon}");

        }
        else
        {
            Console.WriteLine($"name : {name}  >> age {age}");
        }
    }

}
class aa
{
    static void Main()
    {
        person obj1, obj2, obj3;

        obj1 = new person("ahmad", 15);
        obj2 = new person("mahan", 24);
        obj3 = new person("karim", "031653");

        obj1.info();
        obj2.info();
        obj3.info();

    }
}
